# Local development:
# VITE_TOM_API_URL=http://127.0.0.1:8000
# VITE_API_BASE_URL is also supported as a fallback name.

# Production (Vercel):
# Set VITE_TOM_API_URL in Project Settings > Environment Variables to the
# Render service URL, for example:
# VITE_TOM_API_URL=https://tom-api.onrender.com
#
# Vite reads this at build time, so redeploy after changing it.
