# Copy to .env and fill in real values. Never commit .env.
# PostgreSQL (Phase 2 — async SQLAlchemy)
# Use your RAW password if it contains '@' (the app re-encodes it safely).
# If it contains '#', '/' or '?', percent-encode those characters yourself.
TOM_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/tom_chatbot

# CORS (optional overrides)
# TOM_ALLOWED_ORIGINS=["http://localhost:5173"]
